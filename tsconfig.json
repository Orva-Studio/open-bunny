{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@openbunny/lib/*": ["src/lib/*"]
    },
    "types": ["bun-types"]
  },
  "include": ["src/**/*", "apps/e2e/**/*"],
  "exclude": ["node_modules", "dist", "apps/ui"]
}
