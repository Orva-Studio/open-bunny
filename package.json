{
  "name": "openbunny",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --watch src/api/index.ts",
    "dev:worker": "bun run --watch src/worker/index.ts",
    "dev:ui": "bun run --cwd apps/ui dev",
    "build": "bun run build:api && bun run build:worker && bun run --cwd apps/ui build",
    "build:api": "bun build src/api/index.ts --outdir dist/api --target bun",
    "build:worker": "bun build src/worker/index.ts --outdir dist/worker --target bun",
    "test": "bun test ./src",
    "test:e2e": "bun run --cwd apps/e2e test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@ai-sdk/provider": "^3.0.8",
    "@hono/node-server": "^1.19.11",
    "@hono/zod-validator": "^0.7.6",
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/client": "^6.0.0",
    "ai": "^6.0.116",
    "better-auth": "^1.5.4",
    "bullmq": "^5.70.4",
    "hono": "^4.0.0",
    "js-yaml": "^4.1.1",
    "ollama-ai-provider": "^1.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.10",
    "prisma": "^6.0.0",
    "typescript": "^5.4.0"
  }
}
