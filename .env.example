# ─────────────────────────────────────────────
# OpenBunny — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Public URL of the OpenBunny API (used for webhook + OAuth callbacks)
# In production, set this to your public domain: https://openbunny.example.com
BASE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://openbunny:${POSTGRES_PASSWORD}@postgres:5432/openbunny

# Redis connection string
REDIS_URL=redis://redis:6379

# AES-256-GCM encryption key for secrets stored in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# PostgreSQL password (used by docker-compose to create the DB)
POSTGRES_PASSWORD=changeme

# API server port (default: 3000)
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info
